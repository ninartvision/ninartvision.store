# ============================================================
# ENVIRONMENT VARIABLES — copy this file to .env and fill in
# your real values. Never commit .env to version control.
# ============================================================

# Sanity project credentials (find them in sanity.io/manage)
SANITY_PROJECT_ID=yourProjectIdHere
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01

# Optional: read token for draft/preview mode (keep secret!)
# SANITY_API_READ_TOKEN=
