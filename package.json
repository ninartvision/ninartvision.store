{
  "name": "ninartvision-migration",
  "version": "1.0.0",
  "description": "Image migration script for Ninart Vision",
  "type": "module",
  "scripts": {
    "build:js":                "node scripts/minify-js.mjs",
    "build:css":               "node scripts/build-css.mjs",
    "build":                   "npm run build:js && npm run build:css",
    "verify:modal":            "node scripts/verify-no-motion-div.mjs",
    "migrate-images":          "node migrate-images.js",
    "generate-products":       "node scripts/generate-product-pages.mjs",
    "generate-products:clean": "node scripts/generate-product-pages.mjs --clean",
    "audit-slugs":             "node scripts/audit-slugs.mjs",
    "fix-slugs":               "node scripts/audit-slugs.mjs --fix",
    "fix-slugs:dry":           "node scripts/audit-slugs.mjs --dry-run",
    "fix-collisions":          "node scripts/fix-slug-collisions.mjs",
    "fix-collisions:dry":      "node scripts/fix-slug-collisions.mjs --dry-run",

    "//---- backend ----": "Backend lives in its own workspace under ./backend with its own package.json. These aliases forward to that workspace so the same `npm run …` cadence works from the repo root.",
    "backend:install":         "npm --prefix backend install",
    "backend:dev":             "npm --prefix backend run dev",
    "backend:start":           "npm --prefix backend run start",
    "backend:test":            "npm --prefix backend test",
    "backend:check:env":       "npm --prefix backend run check:env"
  },
  "dependencies": {
    "@sanity/client": "^6.15.7"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "sharp": "^0.34.5",
    "terser": "^5.46.0"
  }
}
