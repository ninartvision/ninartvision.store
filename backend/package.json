{
  "name": "ninartvision-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Ninart Vision API — orders, payments, webhooks. Provider-agnostic; built so TBC Bank and Bank of Georgia integrations can be added later without rewriting the backend.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "check:env": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0"
  },
  "optionalDependencies": {
    "firebase-admin": "^13.0.2"
  }
}
