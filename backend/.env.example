# =============================================================================
# Ninart Vision — Backend Environment
# Copy this file to `.env` (which is gitignored) and fill in real values.
# Anything left blank is treated as "feature disabled" rather than crashing,
# so the server can boot in dev/CI without every provider being wired up.
# =============================================================================

# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Public URL the API is reachable at (used to build webhook URLs the banks
# call back to). Must be HTTPS in production — TBC and BOG will refuse to
# register an http:// callback.
PUBLIC_API_URL=http://localhost:4000

# Where the storefront lives. Used for CORS allowlist and as the default
# `returnUrl` we pass to hosted-checkout providers when the frontend doesn't
# specify its own. Comma-separated, no trailing slashes.
WEB_ORIGINS=http://localhost:5173,https://ninartvision.store

# ── Auth (optional) ───────────────────────────────────────────────────────────
# Firebase Admin verifies the ID token the storefront already mints via
# client-side Google sign-in (see auth.js + auth.config.example.js at the
# repo root). When unset, the API still works but every request is treated
# as a guest — protected routes will respond 401.
FIREBASE_PROJECT_ID=
# Either the path to a service-account JSON file…
FIREBASE_SERVICE_ACCOUNT_PATH=
# …or the JSON itself, inline (one-line, useful for hosts like Render/Fly).
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# =============================================================================
# Payment providers
# Each block self-disables when its required keys are empty. That means
# you can deploy with manual-only today and flip TBC / BOG on later by
# setting the keys — no code change required.
#
# After editing any of the values below, run `npm run --prefix backend
# check:env` to confirm the provider you expect is now READY.
# =============================================================================

# Default provider when the frontend doesn't specify one.
# Valid values: manual | tbc | bog
# Leave EMPTY to let the server auto-pick: it prefers TBC → BOG → manual
# based on which providers have their env vars filled in.
PAYMENTS_DEFAULT_PROVIDER=

# Public URL the banks call back to with webhook updates. Defaults to
# PUBLIC_API_URL (above) when empty. Override only if your webhook URL
# is served by a different host than the API — e.g. you put a stable
# CDN-edge URL in front of webhooks for IP-allowlisting reasons.
PAYMENTS_WEBHOOK_BASE_URL=

# ── TBC Bank (E-Commerce / Internet Payment Gateway) ──────────────────────────
# Docs: https://developers.tbcbank.ge/  (request access via business banking)
# We carry both API-key and merchant-cert auth slots because TBC has shipped
# multiple versions of their gateway over the years; the active integration
# will pick whichever pair is populated.
#
# Provider becomes READY when:
#   • TBC_MERCHANT_ID is set, AND
#   • one of: (TBC_CLIENT_ID + TBC_CLIENT_SECRET) | TBC_API_KEY |
#             (TBC_CLIENT_CERT_PEM + TBC_CLIENT_KEY_PEM) is set, AND
#   • TBC_WEBHOOK_SECRET is set (needed to verify their callbacks).
TBC_API_BASE=https://api.tbcbank.ge
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
TBC_API_KEY=
TBC_MERCHANT_ID=
# PEM-encoded contents for the legacy mTLS endpoint. Optional; only needed
# if your merchant agreement uses certificate auth.
TBC_CLIENT_CERT_PEM=
TBC_CLIENT_KEY_PEM=
# HMAC secret TBC signs its webhook callbacks with — used to verify
# inbound /v1/webhooks/tbc requests.
TBC_WEBHOOK_SECRET=
# Currencies your TBC merchant contract is licensed for. Comma-separated.
# Defaults to GEL. Most contracts allow GEL only; multi-currency contracts
# need to be enabled by your bank account manager.
TBC_SUPPORTED_CURRENCIES=GEL

# ── Bank of Georgia (Business Online / Payments API) ──────────────────────────
# Docs: https://api.bog.ge/docs/  (sandbox keys via your BOG account manager)
#
# Provider becomes READY when:
#   • BOG_CLIENT_ID, BOG_CLIENT_SECRET, and BOG_PUBLIC_KEY_PEM are all set.
# The public key is REQUIRED because BOG signs webhooks with RSA-SHA256
# and we refuse to accept callbacks we can't verify.
BOG_API_BASE=https://api.bog.ge
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# RSA public key BOG publishes for verifying their webhook signatures.
# Paste the full -----BEGIN PUBLIC KEY----- block as a one-line string
# (replace newlines with \n). Hosts like Render / Fly handle this natively.
BOG_PUBLIC_KEY_PEM=
# Optional secondary HMAC secret some BOG account configurations also use
# (in addition to RSA). Safe to leave blank if your account uses RSA only.
BOG_WEBHOOK_SECRET=
BOG_SUPPORTED_CURRENCIES=GEL

# ── Manual provider (bank transfer / WhatsApp inquiry) ────────────────────────
# This is the no-redirect fallback the storefront uses today. Leaving it on
# means orders can still be placed even if all bank gateways are offline.
MANUAL_PAYMENTS_ENABLED=true
MANUAL_PAYMENT_INSTRUCTIONS_URL=https://ninartvision.store/terms.html#payment
MANUAL_SUPPORTED_CURRENCIES=GEL,USD,EUR
